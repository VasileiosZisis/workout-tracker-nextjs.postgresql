generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum SessionKind {
  WEIGHTLIFTING
  PACE
  INTERVAL
}

model User {
  id                    String                 @id @default(cuid())
  name                  String?
  email                 String?                @unique
  emailVerified         DateTime?
  image                 String?
  role                  Role                   @default(USER)
  demoExpiresAt         DateTime?
  accounts              Account[]
  sessions              Session[]
  logs                  Log[]
  exercises             Exercise[]
  weightliftingSessions WeightliftingSession[]
  paceSessions          PaceSession[]
  intervalSessions      IntervalSession[]
  workoutRoutines       WorkoutRoutine[]
  workoutEntries        WorkoutEntry[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([demoExpiresAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([token])
  @@unique([identifier, token])
}

model AuthRateLimitBucket {
  id        String   @id
  kind      String
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model Log {
  id                    String                 @id @default(cuid())
  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                 String
  slug                  String
  exercises             Exercise[]
  weightliftingSessions WeightliftingSession[]
  paceSessions          PaceSession[]
  intervalSessions      IntervalSession[]
  workoutRoutine        WorkoutRoutine?
  workoutEntries        WorkoutEntry[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([userId, slug])
  @@index([userId, updatedAt])
}

model Exercise {
  id                    String                 @id @default(cuid())
  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  logId                 String
  log                   Log                    @relation(fields: [logId], references: [id], onDelete: Cascade)
  title                 String
  slug                  String
  sessionKind           SessionKind
  workoutSuggestions    WorkoutExercise[]
  workoutEntryExercises WorkoutEntryExercise[]
  weightliftingSessions WeightliftingSession[]
  paceSessions          PaceSession[]
  intervalSessions      IntervalSession[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([logId, slug])
  @@index([userId, logId])
}

model WeightliftingSession {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  logId         String
  log           Log                @relation(fields: [logId], references: [id], onDelete: Cascade)
  exerciseId    String
  exercise      Exercise           @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  performedAt   DateTime
  totalVolume   Decimal            @default(0) @db.Decimal(12, 2)
  junkVolume    Decimal            @default(0) @db.Decimal(12, 2)
  workingVolume Decimal            @default(0) @db.Decimal(12, 2)
  sets          WeightliftingSet[]
  workoutEntryId String?
  workoutEntry   WorkoutEntry? @relation(fields: [workoutEntryId], references: [id], onDelete: SetNull)
  requestId      String?
  requestFingerprint String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([userId, exerciseId, performedAt])
  @@index([logId, exerciseId])
  @@index([workoutEntryId])
  @@unique([userId, requestId])
}

model WorkoutRoutine {
  id               String @id @default(cuid())
  userId           String
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  logId            String @unique
  log              Log @relation(fields: [logId], references: [id], onDelete: Cascade)
  name             String
  revision         Int @default(0)
  nextDefinitionId String?
  nextDefinition   WorkoutDefinition? @relation("NextWorkout", fields: [nextDefinitionId], references: [id], onDelete: SetNull)
  definitions      WorkoutDefinition[] @relation("RoutineDefinitions")
  entries          WorkoutEntry[]
  schedules        WorkoutSchedule[]
  scheduleRequests WorkoutScheduleRequest[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

model WorkoutDefinition {
  id          String @id @default(cuid())
  routineId   String
  routine     WorkoutRoutine @relation("RoutineDefinitions", fields: [routineId], references: [id], onDelete: Cascade)
  name        String
  position    Int
  archived    Boolean @default(false)
  nextIn      WorkoutRoutine[] @relation("NextWorkout")
  entries     WorkoutEntry[]
  exercises   WorkoutExercise[]

  @@index([routineId, archived, position])
}

model WorkoutExercise {
  id           String @id @default(cuid())
  definitionId String
  definition   WorkoutDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  position     Int

  @@unique([definitionId, exerciseId])
  @@index([definitionId, position])
}

model WorkoutEntryExercise {
  id         String @id @default(cuid())
  entryId    String
  entry      WorkoutEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  position   Int

  @@unique([entryId, exerciseId])
  @@index([entryId, position])
  @@index([exerciseId])
}

enum WorkoutEntryStatus {
  IN_PROGRESS
  COMPLETED
  DISCARDED
}

model WorkoutEntry {
  id           String @id @default(cuid())
  slug         String
  userId       String
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  logId        String
  log          Log @relation(fields: [logId], references: [id], onDelete: Cascade)
  routineId    String
  routine      WorkoutRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  definitionId String
  definition   WorkoutDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  name         String
  performedAt  DateTime
  status       WorkoutEntryStatus @default(IN_PROGRESS)
  requestId    String
  requestFingerprint String?
  scheduleId   String?
  schedule     WorkoutSchedule? @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  slotKey      String?
  plannedName  String?
  scheduledDate DateTime?
  schedulingIntent String @default("ROTATION")
  fulfilledSlot WorkoutSlot?
  completedAt  DateTime?
  sessions     WeightliftingSession[]
  exercises    WorkoutEntryExercise[]
  exercisePlanRevision Int?
  createdAt    DateTime @default(now())

  @@unique([userId, requestId])
  @@unique([logId, slug])
  @@index([userId, logId, performedAt])
  @@index([routineId, status])
  // Migration also enforces one IN_PROGRESS entry per routine via a partial index.
}

// Immutable plan snapshots. endDate/endAt close a superseded version; no
// scheduled sessions or training measurements are copied into these tables.
model WorkoutSchedule {
  id String @id @default(cuid())
  routineId String
  routine WorkoutRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  style String
  timezone String
  weekStart Int
  effectiveAt DateTime
  startDate String
  endAt DateTime?
  endDate String?
  workouts Json
  slots WorkoutSlot[]
  entries WorkoutEntry[]
  @@index([routineId, effectiveAt])
}

model WorkoutSlot {
  id String @id @default(cuid())
  scheduleId String
  schedule WorkoutSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  key String
  outcome String @default("PENDING")
  originalOutcome String?
  entryId String? @unique
  entry WorkoutEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)
  @@unique([scheduleId, key])
}

model WorkoutScheduleRequest {
  id String @id @default(cuid())
  routineId String
  routine WorkoutRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  userId String
  requestId String
  fingerprint String
  outcomeDate String?
  name String?
  operation String?
  weekKey String?
  timezone String?
  @@unique([userId, requestId])
  @@index([routineId, outcomeDate])
  @@index([routineId, weekKey])
}

model WeightliftingSet {
  id          String               @id @default(cuid())
  sessionId   String
  session     WeightliftingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  position    Int
  repetitions Decimal              @db.Decimal(8, 2)
  kilograms   Decimal              @db.Decimal(8, 2)
  isHard      Boolean              @default(false)
  volume      Decimal              @db.Decimal(12, 2)

  @@unique([sessionId, position])
}

model PaceSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logId       String
  log         Log      @relation(fields: [logId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  performedAt DateTime
  hours       Int      @default(0)
  minutes     Int      @default(0)
  seconds     Int      @default(0)
  distance    Decimal  @default(0) @db.Decimal(10, 2)
  pace        Decimal  @default(0) @db.Decimal(10, 3)
  paceMinutes Int      @default(0)
  paceSeconds Int      @default(0)
  speed       Decimal  @default(0) @db.Decimal(10, 3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, exerciseId, performedAt])
  @@index([logId, exerciseId])
}

model IntervalSession {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logId                String
  log                   Log      @relation(fields: [logId], references: [id], onDelete: Cascade)
  exerciseId           String
  exercise             Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  performedAt          DateTime
  rounds               Int
  workSeconds          Int
  recoverySeconds      Int
  includeFinalRecovery Boolean  @default(false)
  totalWorkSeconds     Int
  totalRecoverySeconds Int
  intervalBlockSeconds Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId, exerciseId, performedAt])
  @@index([logId, exerciseId])
}
